{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SnowView",
  "version": "0.2.0",
  "identifier": "com.snowview.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @snowview/web dev",
    "beforeBuildCommand": "pnpm --filter @snowview/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnowView",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0a0e2a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Weather",
    "shortDescription": "Monitor de nieve para estaciones de esquí",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
